<?xml version="1.0" encoding="utf-8"?>

<!-- fragment_home.xml -->


<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="@id/tvHome"
            app:layout_constraintBottom_toBottomOf="@id/tvHome"
            app:layout_constraintEnd_toStartOf="@id/ivProfile"/>

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profile"
            app:layout_constraintTop_toTopOf="@id/tvHome"
            app:layout_constraintBottom_toBottomOf="@id/tvHome"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/bg_circle"/>

        <!-- Welcome Title -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome AI\nNotes"
            android:textSize="32sp"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvHome"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Start   "
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:paddingHorizontal="32dp"
                android:layout_marginEnd="12dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/blue_light"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFeatures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Features  "
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/blue_light"/>

        </LinearLayout>

        <!-- Summarize Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSummarize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/layoutButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSummarize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Summarize your"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivSummarize"/>

                <ImageView
                    android:id="@+id/ivSummarize"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/summarize_icon"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste your notes below to"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvSummarize"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvReady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvPaste"
                    app:layout_constraintStart_toStartOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:progress="60"
                    android:progressTint="@color/blue_light"
                    android:progressBackgroundTint="@color/white"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvReady"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions Title -->
        <TextView
            android:id="@+id/tvQuickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/cardSummarize"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Quick Actions Grid -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridQuickActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:columnCount="2"
            app:rowCount="2"
            app:layout_constraintTop_toBottomOf="@id/tvQuickActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Card 1: New Your -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_light"
                app:layout_columnWeight="1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivLock"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lock"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/ivNew"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/avatar_1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New"
                        android:textSize="12sp"
                        android:textColor="@color/gray_dark"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/ivLock"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvYour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toBottomOf="@id/tvNew"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ProgressBar
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progress="40"
                        android:progressTint="@color/blue_light"
                        android:progressBackgroundTint="@color/white"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvYour"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnCreate"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreate"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Create"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:paddingHorizontal="12dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/white"
                        android:textColor="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/tvYour"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Saved Review -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_light"
                app:layout_columnWeight="1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_check"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/ivSaved"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/avatar_2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saved"
                        android:textSize="12sp"
                        android:textColor="@color/gray_dark"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/ivCheck"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toBottomOf="@id/tvSaved"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ProgressBar
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progress="30"
                        android:progressTint="@color/blue_light"
                        android:progressBackgroundTint="@color/white"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvReview"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnView"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnView"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="View"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:paddingHorizontal="16dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/white"
                        android:textColor="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/tvReview"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3 & 4 (placeholder) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_light"
                app:layout_columnWeight="1"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_light"
                app:layout_columnWeight="1"/>

        </androidx.gridlayout.widget.GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>